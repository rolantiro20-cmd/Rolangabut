<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="440" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Island" Width="190" Height="34" Margin="0,6,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="Black" CornerRadius="17" ClipToBounds="True"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
            SizeChanged="Island_SizeChanged">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Keluar" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Tampilan kecil -->
            <Grid x:Name="CompactView" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ArtSmall" Width="22" Height="22" CornerRadius="5" Background="#222222" />
                <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0,4,0"
                           Foreground="White" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="Memuat..." />
            </Grid>

            <!-- Tampilan besar -->
            <Grid x:Name="ExpandedView" Margin="14" Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ArtBig" Width="88" Height="88" CornerRadius="12"
                        Background="#222222" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Text="Tidak ada musik" />
                    <TextBlock x:Name="ArtistText" Foreground="#AAAAAA" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,2"
                                 Foreground="White" Background="#333333" BorderThickness="0"
                                 Minimum="0" Maximum="1" Value="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" />
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;" Click="PlayPause_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
